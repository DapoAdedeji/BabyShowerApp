// Cloudflare Workers config — tells `wrangler deploy` / `wrangler preview`
// what to publish. The site is plain static files (no build step) served
// from the repo root; worker/index.js adds a small /api for the Jeopardy
// question editor, backed by KV. `name` must match the Worker's name in the
// Cloudflare dashboard. The admin password is the ADMIN_PASSWORD secret
// (dashboard → Settings → Variables and Secrets), never stored here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "babyshowerapp",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // Where edited Jeopardy questions are saved. The id pins the
  // "babyshowerapp-questions" namespace so production AND branch previews
  // use the same store (without it, previews weren't connected).
  "kv_namespaces": [
    { "binding": "QUESTIONS", "id": "a8b5223cc6a9484795f3d4dbe774dbba" }
  ],
  // Settings for branch preview builds (`wrangler preview`). Assets and
  // compatibility settings are inherited from above, but bindings are NOT,
  // so the KV store is repeated here. Same id = previews share the live
  // question set. Preview secrets are separate too:
  //   npx wrangler preview base-config secret put ADMIN_PASSWORD
  "previews": {
    "kv_namespaces": [
      { "binding": "QUESTIONS", "id": "a8b5223cc6a9484795f3d4dbe774dbba" }
    ]
  },
  // Gives each branch preview a URL like
  // https://<branch>-babyshowerapp.<subdomain>.workers.dev
  // (Worker-level setting: takes effect on a production `wrangler deploy`,
  // or enable "Preview URLs" in the dashboard under Domains & Routes.)
  "preview_urls": true
}
